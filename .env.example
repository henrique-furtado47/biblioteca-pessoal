# Copie para .env e preencha com as credenciais do seu projeto Supabase
# (Project Settings -> API)
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_ANON_KEY=sua-anon-public-key

# (Opcional) Chave da Google Books API para aumentar a cota da busca por ISBN.
# Sem ela, a busca usa a cota anônima compartilhada (sujeita a 429) e cai
# automaticamente para a Open Library. Crie em https://console.cloud.google.com
# VITE_GOOGLE_BOOKS_API_KEY=sua-chave-google-books
